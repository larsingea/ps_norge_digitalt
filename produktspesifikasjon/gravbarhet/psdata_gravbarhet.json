  "identificationSection": {
    "title": "Gravbarhet",
    "abstract": "Datasettet viser om det er lett eller vanskelig å grave i bunnen. Gravbarhet er basert på sedimentfordeling, og angir både hvor enkelt det er å grave i bunnen og den forventede stabiliteten til det utgravde området. For eksempel vil sandige sedimenter gjerne kollapse fortere etter utgravning enn hva mer finkornig materiale vil.",
    "purpose": {
      "summary": "Gravbarhet er et avledet temakart som presenterer kornstørrelsesdata på en spesialtilpasset måte. Datasettet viser om det er lett eller vanskelig å grave i bunnen.",
      "useCase": {
        "name": "Bruksområde",
        "summary": "Datasettet kan anvendes som underlag i overordnet areal- og miljøplanlegging, i forbindelse med installasjoner på sjøbunnen osv."
      }
    },
